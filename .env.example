# Copy to .env for local development:   cp .env.example .env
# NEVER commit the real .env file. On Render, set these in the dashboard instead.

# --- Branding ---------------------------------------------------------------
# Shown in the website header, home page and About page. Set your real name here.
UNIVERSITY_NAME=Mehran University of Engineering and Technology

# --- Admin contact card (shown on the website; replace the placeholders) ----
ADMIN_CONTACT_NAME=Lost & Found Administrator
ADMIN_CONTACT_EMAIL=xxx@gmail.com
ADMIN_CONTACT_PHONE=03XX-XXXXXXX
OFFICE_LOCATION=[Lost & Found office location]
OFFICE_HOURS=[Opening hours]

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Set to 1 when deployed behind a proxy (Render) so rate limiting sees real client IPs.
TRUST_PROXY=

# Comma-separated list of frontend origins allowed to call this API (no trailing slash).
# REQUIRED in production, e.g. https://findit-campus.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Storage ----------------------------------------------------------------
# SQLite file and uploaded photos. On Render, point these at a persistent disk
# mount (e.g. /var/data/findit.db and /var/data/uploads). See README.
DB_PATH=./data/findit.db
UPLOAD_DIR=./uploads
MAX_IMAGE_MB=3

# --- Administrator ----------------------------------------------------------
# Used ONLY to create the first admin when none exists (also by `npm run admin:create`).
# Choose your own strong password (10+ characters). Do not reuse a personal password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=8

# --- Optional ---------------------------------------------------------------
# Comma-separated campus locations to replace the defaults (exact-location matching only).
# CAMPUS_LOCATIONS=Library,Cafeteria,Main Hall,Lab Block

# Load sample reports on startup if the database is empty (handy for a live demo).
# Leave false for a real deployment.
SEED_DEMO_DATA=false

# Rate limits (defaults shown).
# RATE_LIMIT_GLOBAL=300      requests per 15 minutes per IP
# RATE_LIMIT_WRITES=20       reports/claims per hour per IP
# RATE_LIMIT_LOGIN=10        failed admin logins per 15 minutes per IP
