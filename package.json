{
  "name": "findit-campus-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + SQLite API for FindIt Campus (single-campus lost & found)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node database/init.js",
    "db:seed": "node database/seed.js",
    "db:reset": "node database/seed.js --reset",
    "admin:create": "node scripts/create-admin.js",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0"
  }
}
