# Copy to .env.local for local development.  On Vercel, set this under Project -> Settings -> Environment Variables.
# Vite bakes VITE_* values into the build, so redeploy after changing them.

# Base URL of the backend API (no trailing slash).
VITE_API_URL=http://localhost:4000

# The administrator's contact details and the university name are NOT set here.
# They live in backend/.env (ADMIN_CONTACT_*, OFFICE_*, UNIVERSITY_NAME).
